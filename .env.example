# Copy to .env and adjust. Docker Compose loads .env automatically for variable substitution.

# Postgres (one DB per postgres service in multiregion mode)
POSTGRES_USER=quota
POSTGRES_PASSWORD=dev
POSTGRES_DB=quota
# POSTGRES_VERSION=16.16-bookworm  # optional override; pin lives in versions.env (exported by make)

# Gateway (only quota-api-gateway publishes a host port for the public API)
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Ops port (livez, readyz, /metrics) stays on the internal network in Compose; optional local bind:
# OPS_BIND=127.0.0.1
# OPS_PORT_HOST=8081

# Single-region stack only (default compose); required for region-quota-service serve
REGION_ID=ir-thr-1
# GATEWAY_REGIONS=ir-thr-1=region-quota-service:9090

# Local `make migrate` when Postgres is published or tunneled (optional)
# DATABASE_URL=postgres://quota:dev@127.0.0.1:5432/quota?sslmode=disable

# Region service DB pool (optional; pgx defaults when unset)
# DB_POOL_MAX_CONNS=25
# DB_POOL_MIN_CONNS=2
# DB_POOL_MAX_CONN_LIFETIME=30m
# DB_POOL_MAX_CONN_IDLE_TIME=5m

# Timeouts (Go duration strings: 5s, 1m, 500ms). Unset = documented default; 0 disables optional limits.
# Gateway HTTP
# HTTP_READ_HEADER_TIMEOUT=5s
# HTTP_SHUTDOWN_TIMEOUT=10s
# GATEWAY_HEALTHCHECK_TIMEOUT=3s
# Gateway → region gRPC (GATEWAY_GRPC_REGION_TIMEOUT=0 leaves request deadline as-is)
# GATEWAY_GRPC_REGION_TIMEOUT=
# GATEWAY_GRPC_FANOUT_TIMEOUT=3s
# GATEWAY_GRPC_HEALTH_TIMEOUT=2s
# GATEWAY_CIRCUIT_BREAKER_OPEN_TIMEOUT=30s
# Region service
# DB_QUERY_TIMEOUT=
# IDEMPOTENCY_LEASE_TIMEOUT=15s
# DEFAULT_RESERVATION_TTL_SECONDS=

# Observability
LOG_LEVEL=info
# Compose defaults OTLP to otel-collector; Prometheus UI on METRICS_BIND:PROMETHEUS_PORT (default 127.0.0.1:9091)
METRICS_BIND=127.0.0.1
PROMETHEUS_PORT=9091
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SDK_DISABLED=true